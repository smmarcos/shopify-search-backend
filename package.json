    "pg": "^8.11.3",
    "pgvector": "^0.1.8",
    "ioredis": "^5.3.2",
    "openai": "^4.28.0",
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "winston": "^3.11.0",
    "bull": "^4.12.2",
    "joi": "^17.12.2",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
